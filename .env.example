# ============================================================
# NUMBER OVER — Variables d'environnement (GABARIT)
# Copier vers `.env.local` et remplir. NE JAMAIS versionner .env.local
# ============================================================

# ---------- Application ----------
# URL publique du site (utilisée pour les webhooks et les liens e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | test | production
NODE_ENV=development

# ---------- Supabase ----------
# Publiques (préfixe NEXT_PUBLIC_) : exposées au navigateur, protégées par RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — serveur uniquement. Contourne RLS. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Twilio (SECRET — serveur uniquement) ----------
# Non utilisées en phase 2. Préparées pour la phase 5.
TWILIO_ACCOUNT_SID=
# Recommandé : clé API + secret plutôt que l'Auth Token principal
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Requis pour la validation des signatures webhook (X-Twilio-Signature)
TWILIO_AUTH_TOKEN=

# ---------- Paiement (SECRET — serveur uniquement) ----------
# Non utilisées en phase 2. Fournisseur à confirmer avant la phase 9.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------- Tâches planifiées ----------
# Secret partagé protégeant les routes /api/cron/*
CRON_SECRET=
