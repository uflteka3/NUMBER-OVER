{
  "name": "number-over",
  "version": "0.1.0",
  "private": true,
  "description": "NUMBER OVER — plateforme de numéros virtuels (vente et location).",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:secrets && npm run build",
    "db:migrate:local": "bash supabase/tests/run-migrations.sh numberover_test",
    "db:test": "node supabase/tests/security.test.mjs numberover_test",
    "db:types:local": "DATABASE_URL=postgresql://postgres@localhost:54329/numberover_test node scripts/gen-db-types.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
